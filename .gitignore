# Terraform files
# Ignore .terraform directories
.terraform/

# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore Terraform plan files
*.tfplan

# Ignore backup files
*.bak

# Ignore crash logs
crash.log

# Ignore override files
# Override files are typically used for local overrides and should not be committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore sensitive environment variables
*.tfvars
*.tfvars.json

# Ignore the following IDE files
.idea/
.vscode/

# Ignore log files
*.log


# React files inside my-app folder
# dependencies
my-app/node_modules
my-app/.pnp
my-app.pnp.js

# testing
my-app/coverage

# production
my-app/build

# misc
my-app/.DS_Store
my-app/.env.local
my-app/.env.development.local
my-app/.env.test.local
my-app/.env.production.local

# editor folders
my-app/.vscode/
my-app/.idea/

# log files
my-app/npm-debug.log*
my-app/yarn-debug.log*
my-app/yarn-error.log*
my-app/*.log

# OS-specific files
my-app/Thumbs.db
my-app/ehthumbs.db

# build artifacts
my-app/*.tsbuildinfo

# package manager caches
my-app/.npm/
my-app/.yarn/cache

# environment variables
my-app/.env.* 

# serverless deployment
my-app/.serverless/

# Sublime Text project files
my-app/*.sublime-project
my-app/*.sublime-workspace

# Docker files (uncomment to ignore them)
# Dockerfile
# docker-compose.yml

# Nginx configuration (uncomment to ignore)
# nginx.conf
